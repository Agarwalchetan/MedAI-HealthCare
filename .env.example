# Database
MONGODB_URI=your-mongo-url
DB_NAME=MedAI

# JWT
JWT_SECRET=your-jwt-sessionkey
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5173

# File Upload (Cloudinary - optional for Phase 1)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend Email Service
YOUR_RESEND_API_KEY=your-resend-api-key

# Deepgram (voice to text converter/ text to voice converter)
DEEPGRAM_API_KEY=
VITE_DEEPGRAM_API_KEY=

# Sarvam AI (Indian Language Translation)
SARVAM_API_KEY=

# google cloud vision api
GOOGLE_CLOUD_VISION_API=

#for paramedics
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

#for health vault
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# for Google Translate
GOOGLE_TRANSLATE_API_KEY=
VITE_GOOGLE_TRANSLATE_API_KEY=
